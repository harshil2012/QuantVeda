# QuantVeda AI Configuration Template

# API keys for AI capabilities (Google AI Studio Gemini)
GEMINI_API_KEY=

# JWT Authentication Secret Key (Change this in production)
JWT_SECRET=quantveda-secure-jwt-secret-key-2026-prod

# -------------------------------------------------------------
# REAL EMAIL DELIVERY (SMTP)
# Works with Gmail, Brevo, AWS SES, SendGrid, Outlook, etc.
# For Gmail:
#   1. Enable 2-Step Verification on your Google Account
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#   3. Fill SMTP_USER with your gmail address and SMTP_PASSWORD with the 16-character App Password
# -------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=True

# -------------------------------------------------------------
# REAL PHONE SMS DELIVERY
# Option 1: Twilio (Global SMS)
# Get credentials from https://console.twilio.com/
# -------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option 2: Fast2SMS (Indian Mobile Numbers - Quick Setup)
# Get free API key from https://www.fast2sms.com/
FAST2SMS_API_KEY=

# -------------------------------------------------------------
# FIREBASE AUTHENTICATION (Email & Phone Number OTP)
# Get credentials from https://console.firebase.google.com/
# 1. Create a Firebase Project and enable Authentication:
#    - Enable 'Email/Password' provider
#    - Enable 'Phone' provider
# 2. Register a Web App under Project Settings to get client keys:
# -------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Optional: Firebase Admin Service Account Key JSON path (for backend token verification)
# Download from Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=
